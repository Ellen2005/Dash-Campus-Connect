rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DASH — CAMPUS CONNECT SECURITY RULES
     * 
     * Core Philosophy:
     * This ruleset enforces a multi-tenant university-isolation model. All data is scoped 
     * under /universities/{universityId}. Access is strictly authorized based on 
     * university membership and specific user roles (student, admin, superadmin, wellbeing_admin).
     * 
     * Data Structure:
     * The hierarchy follows /universities/{uId}/{collection}/{doc}. Sub-collections 
     * utilize path-based ownership or denormalized authorization fields to ensure 
     * "Authorization Independence," avoiding nested get() calls where possible.
     * 
     * Key Security Decisions:
     * 1. Multi-Tenancy: Users can only interact with data belonging to their universityId.
     * 2. Prototyping Flexibility: Schema validation is limited to critical relational fields 
     *    (ids, owner references) to allow rapid frontend iteration.
     * 3. Role-Based Access (DBAC): Roles are stored in UserProfile documents and fetched 
     *    via helper functions for administrative operations.
     * 4. Denormalization for Performance: Authorization-critical data (like participant lists 
     *    in chats or RSVP status in events) is copied onto child documents to simplify rules.
     * 5. Privacy: Sensitive collections (Timetables, Notifications, Wellbeing tickets) 
     *    are restricted to the specific owner or authorized specialized roles.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getProfile(uId, userId) {
      return get(/databases/$(database)/documents/universities/$(uId)/userProfiles/$(userId)).data;
    }

    function hasRole(uId, role) {
      return isSignedIn() && getProfile(uId, request.auth.uid).role == role;
    }

    function isAdmin(uId) {
      return hasRole(uId, 'admin') || hasRole(uId, 'superadmin');
    }

    function isSuperAdmin(uId) {
      return hasRole(uId, 'superadmin');
    }

    function isWellbeingAdmin(uId) {
      return hasRole(uId, 'wellbeing_admin');
    }

    function isMember(list) {
      return isSignedIn() && request.auth.uid in list;
    }

    function isValidUniversity(uId) {
      return isSignedIn() && getProfile(uId, request.auth.uid).universityId == uId;
    }

    // --- COLLECTION RULES ---

    /**
     * @description University configuration and global settings.
     * @path /universities/{universityId}
     * @allow (get) Any authenticated user in the university. (update) Platform superadmins.
     * @deny (write) Any non-superadmin user.
     * @principle Restricts global config changes to top-level administration.
     */
    match /universities/{universityId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSuperAdmin(universityId);
      allow update: if isSuperAdmin(universityId) && resource != null;
      allow delete: if isSuperAdmin(universityId) && resource != null;

      /**
       * @description User profile data including roles and affiliations.
       * @path /universities/{universityId}/userProfiles/{userId}
       * @allow (create/update) The user matching the UID. (read) Any university member.
       * @deny (update) Changing the immutable username or university affiliation.
       * @principle Enforces self-ownership for profile management and university-wide visibility.
       */
      match /userProfiles/{userId} {
        allow get, list: if isValidUniversity(universityId);
        allow create: if isOwner(userId) && request.resource.data.universityId == universityId;
        allow update: if (isOwner(userId) || isAdmin(universityId)) && resource != null && request.resource.data.username == resource.data.username;
        allow delete: if isAdmin(universityId) && resource != null;

        /**
         * @description Personal notifications for the user.
         * @path /universities/{universityId}/userProfiles/{userId}/notifications/{notificationId}
         * @allow (read/update) The notification recipient.
         * @deny (read) Any other user, including admins.
         * @principle Strict path-based ownership for private inbox data.
         */
        match /notifications/{notificationId} {
          allow get, list: if isOwner(userId);
          allow create: if isValidUniversity(universityId); // Typically created by Cloud Functions
          allow update, delete: if isOwner(userId) && resource != null;
        }

        /**
         * @description Student's private course timetable.
         * @path /universities/{universityId}/userProfiles/{userId}/timetables/{timetableId}
         * @allow (read/write) The timetable owner.
         * @deny (read) Any other user.
         * @principle Ensures academic privacy via direct UID matching.
         */
        match /timetables/{timetableId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }
      }

      /**
       * @description Social media posts and campus feed items.
       * @path /universities/{universityId}/posts/{postId}
       * @allow (create) Signed-in members setting themselves as author. (update/delete) Author or Admin.
       * @deny (update) Changing the authorId or universityId after creation.
       * @principle Public university read with owner-managed write control.
       */
      match /posts/{postId} {
        allow get, list: if isValidUniversity(universityId);
        allow create: if isValidUniversity(universityId) && request.resource.data.authorId == request.auth.uid;
        allow update: if (resource.data.authorId == request.auth.uid || isAdmin(universityId)) && resource != null && request.resource.data.authorId == resource.data.authorId;
        allow delete: if (resource.data.authorId == request.auth.uid || isAdmin(universityId)) && resource != null;

        /**
         * @description Comments nested under specific posts.
         * @path /universities/{universityId}/posts/{postId}/comments/{commentId}
         * @allow (create) University members. (update) Comment author or admin.
         * @deny (read) Users outside the university.
         * @principle Hierarchical engagement with ownership-based write permissions.
         */
        match /comments/{commentId} {
          allow get, list: if isValidUniversity(universityId);
          allow create: if isValidUniversity(universityId) && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if (resource.data.authorId == request.auth.uid || isAdmin(universityId)) && resource != null;
        }

        /**
         * @description Poll data associated with a post.
         * @path /universities/{universityId}/posts/{postId}/polls/{pollId}
         * @allow (read) University members. (update) Members casting a vote.
         * @deny (update) Modifying other people's votes or poll options.
         * @principle Integrated poll security allowing community participation.
         */
        match /polls/{pollId} {
          allow get, list: if isValidUniversity(universityId);
          allow create: if isValidUniversity(universityId) && (isAdmin(universityId) || get(/databases/$(database)/documents/universities/$(universityId)/posts/$(postId)).data.authorId == request.auth.uid);
          allow update: if isValidUniversity(universityId) && resource != null; 
          allow delete: if isAdmin(universityId) && resource != null;
        }
      }

      /**
       * @description Real-time chat conversations.
       * @path /universities/{universityId}/conversations/{conversationId}
       * @allow (read/update) Users listed in the participantIds array.
       * @deny (read) Any user not explicitly invited to the conversation.
       * @principle Shared access model for private group or 1-on-1 communication.
       */
      match /conversations/{conversationId} {
        allow get, list: if isMember(resource.data.participantIds);
        allow create: if isValidUniversity(universityId) && isMember(request.resource.data.participantIds);
        allow update: if isMember(resource.data.participantIds) && resource != null;
        allow delete: if isAdmin(universityId) && resource != null;

        /**
         * @description Messages within a specific conversation.
         * @path /universities/{universityId}/conversations/{conversationId}/messages/{messageId}
         * @allow (read/create) Participants of the parent conversation.
         * @deny (create) Sending a message as someone else.
         * @principle Uses denormalized participantIds on the message for authorization independence.
         */
        match /messages/{messageId} {
          allow get, list: if isMember(resource.data.participantIds);
          allow create: if isMember(request.resource.data.participantIds) && request.resource.data.senderId == request.auth.uid;
          allow update: if isMember(resource.data.participantIds) && resource != null;
          allow delete: if (resource.data.senderId == request.auth.uid || isAdmin(universityId)) && resource != null;
        }
      }

      /**
       * @description Campus events and RSVP management.
       * @path /universities/{universityId}/events/{eventId}
       * @allow (read) University members. (update) Organizer or Admin.
       * @deny (update) Changing the organizerId.
       * @principle Public event visibility with restricted management rights.
       */
      match /events/{eventId} {
        allow get, list: if isValidUniversity(universityId);
        allow create: if isValidUniversity(universityId) && request.resource.data.organiserId == request.auth.uid;
        allow update: if (resource.data.organiserId == request.auth.uid || isAdmin(universityId) || isValidUniversity(universityId)) && resource != null;
        allow delete: if (resource.data.organiserId == request.auth.uid || isAdmin(universityId)) && resource != null;

        /**
         * @description Shared photo album for an event.
         * @path /universities/{universityId}/events/{eventId}/photos/{photoId}
         * @allow (read) Attendees or event organizer. (create) Verified attendees.
         * @deny (create) Users who did not attend or RSVP to the event.
         * @principle Restricted access based on denormalized RSVP/Check-in status.
         */
        match /photos/{photoId} {
          allow get, list: if isValidUniversity(universityId);
          allow create: if isValidUniversity(universityId) && request.resource.data.uploaderId == request.auth.uid;
          allow update, delete: if (resource.data.uploaderId == request.auth.uid || isAdmin(universityId)) && resource != null;
        }
      }

      /**
       * @description Marketplace listings for student trade.
       * @path /universities/{universityId}/listings/{listingId}
       * @allow (read) University members. (write) Listing owner or Admin.
       * @deny (update) Transferring a listing to another seller.
       * @principle Public marketplace visibility with owner-only editing.
       */
      match /listings/{listingId} {
        allow get, list: if isValidUniversity(universityId);
        allow create: if isValidUniversity(universityId) && request.resource.data.sellerId == request.auth.uid;
        allow update, delete: if (resource.data.sellerId == request.auth.uid || isAdmin(universityId)) && resource != null;
      }

      /**
       * @description Support tickets submitted by students.
       * @path /universities/{universityId}/helpDeskTickets/{ticketId}
       * @allow (read) Submitter or assigned Admin. (update) Admin or Submitter (to reopen).
       * @deny (read) Wellbeing tickets to non-wellbeing admins.
       * @principle Privacy-sensitive routing for student support and wellbeing.
       */
      match /helpDeskTickets/{ticketId} {
        allow get, list: if isOwner(resource.data.submitterId) || (resource.data.isWellbeingTicket ? isWellbeingAdmin(universityId) : isAdmin(universityId));
        allow create: if isValidUniversity(universityId) && request.resource.data.submitterId == request.auth.uid;
        allow update: if isOwner(resource.data.submitterId) || (resource.data.isWellbeingTicket ? isWellbeingAdmin(universityId) : isAdmin(universityId));
        allow delete: if isAdmin(universityId) && resource != null;

        /**
         * @description Replies within a support ticket.
         * @path /universities/{universityId}/helpDeskTickets/{ticketId}/replies/{replyId}
         * @allow (read/create) Original ticket submitter or authorized admin.
         * @deny (read) Standard admins from viewing wellbeing ticket replies.
         * @principle Uses denormalized ticket flags for role-based thread isolation.
         */
        match /replies/{replyId} {
          allow get, list: if isOwner(resource.data.ticketSubmitterId) || (resource.data.ticketIsWellbeingTicket ? isWellbeingAdmin(universityId) : isAdmin(universityId));
          allow create: if isValidUniversity(universityId);
          allow update, delete: if isAdmin(universityId) && resource != null;
        }
      }

      /**
       * @description Official university announcements.
       * @path /universities/{universityId}/announcements/{announcementId}
       * @allow (read) University members. (write) University admins.
       * @deny (write) Any non-admin student.
       * @principle Official broadcast channel controlled by verified staff.
       */
      match /announcements/{announcementId} {
        allow get, list: if isValidUniversity(universityId);
        allow create, update, delete: if isAdmin(universityId);
      }

      /**
       * @description Student clubs and societies.
       * @path /universities/{universityId}/clubs/{clubId}
       * @allow (read) University members. (update) Club Admin or Moderator.
       * @deny (create) Students creating unverified clubs (requires Admin).
       * @principle Shared organizational management for student groups.
       */
      match /clubs/{clubId} {
        allow get, list: if isValidUniversity(universityId);
        allow create: if isAdmin(universityId);
        allow update: if (resource.data.adminUserId == request.auth.uid || request.auth.uid in resource.data.moderatorUserIds || isAdmin(universityId)) && resource != null;
        allow delete: if isAdmin(universityId) && resource != null;
      }

      /**
       * @description Moderation reports against content or users.
       * @path /universities/{universityId}/reports/{reportId}
       * @allow (create) Any university member. (read/update) University admins.
       * @deny (read) Reporters viewing the status of their own reports (restricted to admin).
       * @principle Secure reporting pipeline for community safety.
       */
      match /reports/{reportId} {
        allow create: if isValidUniversity(universityId) && request.resource.data.reporterId == request.auth.uid;
        allow get, list, update, delete: if isAdmin(universityId);
      }

      /**
       * @description Immutable log of all administrative moderation actions.
       * @path /universities/{universityId}/moderationLogs/{logId}
       * @allow (read) University admins.
       * @deny (write/delete) Any modification to the audit trail.
       * @principle High-integrity auditing for administrative accountability.
       */
      match /moderationLogs/{logId} {
        allow get, list: if isAdmin(universityId);
        allow create: if isAdmin(universityId); // Logged by Cloud Functions
        allow update, delete: if false; 
      }

      /**
       * @description Catalog of hashtags for discovery.
       * @path /universities/{universityId}/hashtags/{hashtagId}
       * @allow (read) University members.
       * @deny (write) Manual student creation (handled by system).
       * @principle Public discovery index for campus content.
       */
      match /hashtags/{hashtagId} {
        allow get, list: if isValidUniversity(universityId);
        allow create, update, delete: if isAdmin(universityId); // System maintained
      }
    }
  }
}