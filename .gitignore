# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ───────────────────────────────────────────────────────
/.next/
/out/
/build

# ── Environment variables (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.test
.env*.local

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
dev.err.log
dev-output.txt

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── Genkit ────────────────────────────────────────────────────────────────────
.genkit/*

# ── Firebase (legacy, not used) ───────────────────────────────────────────────
firebase-debug.log
firestore-debug.log

# ── Prisma generated ──────────────────────────────────────────────────────────
/src/generated/prisma

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Misc ──────────────────────────────────────────────────────────────────────
.modified
coverage/
