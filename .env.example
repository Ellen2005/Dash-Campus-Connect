# ============================================
# Dash Campus Connect - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control!
# ============================================

# --- Supabase Database ---
# Get these from your Supabase project dashboard > Project Settings > Database
# Use transaction pooler (port 6543) for Prisma with pgBouncer
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for migrations
DIRECT_URL="postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---
# Get these from your Supabase project dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# --- Supabase Service Role Key (KEEP SECRET - backend only) ---
# Get this from Supabase dashboard > Project Settings > API > service_role key
# This key bypasses Row Level Security. Never expose it client-side.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- AI & Generation ---
# Get from Google AI Studio / MakerSuite
GOOGLE_GENKIT_API_KEY="your-google-genkit-api-key"

# --- Stripe (Optional) ---
# Uncomment when implementing Stripe payments
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- App Configuration ---
NEXT_PUBLIC_APP_NAME="Dash"
NODE_ENV="development"

# --- Database SSL (Optional) ---
# Set to "false" if using self-signed certs in development
# DATABASE_SSL_REJECT_UNAUTHORIZED="true"