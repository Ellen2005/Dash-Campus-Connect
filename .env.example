# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string (URI)
#
# DATABASE_URL = Transaction pooler (port 6543) — use for the running app
# DIRECT_URL   = Session pooler (port 5432) — use for prisma migrate / db push
#                 Prefer pooler:5432 over db.[ref].supabase.co if direct host gives ENOTFOUND
#
# Example (replace [ref], [password], [region]):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# If unsure, run: npm run db:direct-url  (copies port 5432 URL from DATABASE_URL)
#
# If password has special characters (@ # %), URL-encode them.
DATABASE_URL=
DIRECT_URL=

# ─── AI / Google Genkit ───────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GENKIT_API_KEY=

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Dash
NEXT_PUBLIC_APP_URL=http://localhost:9002
NODE_ENV=development
NEXT_PUBLIC_ENABLE_MOCK_DATA=false

# ─── Payments (optional) ──────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
