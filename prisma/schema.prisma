// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ============= User & Authentication =============
model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  password              String?         // Optional if using Supabase Auth
  name                  String
  username              String?         @unique
  studentId             String?
  bio                   String?         @db.Text
  tourCompletedAt       DateTime?
  profilePhoto          String?
  coverPhoto            String?
  
  // School & Academic Info
  schoolId              String?
  school                School?         @relation("SchoolStudents", fields: [schoolId], references: [id])
  fieldOfStudyId        String?
  fieldOfStudy          FieldOfStudy?   @relation(fields: [fieldOfStudyId], references: [id])
  levelId               String?
  level                 Level?          @relation(fields: [levelId], references: [id])
  
  interests             String[]        @default([]) // Stored as JSONB
  phone                 String?
  secondaryEmail        String?
  hometown              String?
  notificationPrefs     Json?           // User notification preferences
  
  // Privacy settings
  privacyPublic         Boolean         @default(true)
  onlyFriendsCanSeePosts Boolean        @default(false)
  hideFromMarketplace   Boolean         @default(false)
  
  // Account Status
  role                  Role            @default(USER)
  isStudentAdmin        Boolean         @default(false)
  approvalStatus        ApprovalStatus  @default(PENDING)
  approvalRejectedReason String?
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  posts                 Post[]
  comments              Comment[]
  likes                 Like[]
  events                Event[]
  eventAttendees        EventAttendee[]
  listings              MarketplaceListing[]
  reviews               Review[]
  followers             Follow[]        @relation("follower")
  following             Follow[]        @relation("following")
  groupMemberships      GroupMember[]
  messages              Message[]
  receivedMessages      Message[]       @relation("DirectMessages")
  mentionedIn           Mention[]
  createdGroups         Group[]         @relation("groupCreator")
  communityMemberships  CommunityMember[] @relation("user")
  communityPosts        CommunityPost[]
  createdCommunities    Community[]     @relation("communityCreator")
  brands                Brand[]
  orders                Order[]
  shoppingCart          ShoppingCart?
  supportTickets        SupportTicket[]
  adminChatMessages     AdminChatMessage[]
  lostFoundItems        LostFoundItem[]
  stories               Story[]
  notifications         Notification[]  @relation("UserNotifications")
  reportedFlags         ModeratorFlag[] @relation("ReportedFlags")
  ticketMessages        TicketMessage[] @relation("TicketMessages")
  uploadedResources     LibraryResource[]
  activityLogs          ActivityLog[]

  @@unique([schoolId, studentId])
  @@index([email])
  @@index([studentId])
  @@index([username])
  @@index([schoolId])
  @@index([fieldOfStudyId])
  @@index([levelId])
  @@index([approvalStatus])
  @@index([createdAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// ============= Schools & Admin Portal =============
model School {
  id              String              @id @default(cuid())
  name            String
  country         String?
  allowedDomain   String?
  requireApproval Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  admin           AdminAccount?
  students        User[]              @relation("SchoolStudents")
  fieldsOfStudy   FieldOfStudy[]
  levels          Level[]
  communities     Community[]
  libraryResources LibraryResource[]

  @@index([createdAt])
}

model FieldOfStudy {
  id              String              @id @default(cuid())
  name            String              // e.g., "Engineering", "Medicine"
  description     String?             @db.Text
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId        String
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  students        User[]
  communities     Community[]         @relation("FieldCommunities")

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Level {
  id              String              @id @default(cuid())
  name            String              // e.g., "Level 1", "Level 2"
  description     String?             @db.Text
  order           Int                 @default(0)
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId        String
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  students        User[]
  communities     Community[]         @relation("LevelCommunities")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([order])
}

enum AdminRole {
  OWNER
}

model AdminAccount {
  id           String    @id @default(cuid())
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId     String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(OWNER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     AdminSession[]
}

model AdminSession {
  id        String       @id @default(cuid())
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  tokenHash String       @unique
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

// ============= Communities & Groups =============
model Community {
  id                  String              @id @default(cuid())
  name                String
  description         String?             @db.Text
  photo               String?
  type                CommunityType       @default(STUDENT_CREATED)
  
  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId            String
  
  // For auto-assigned communities
  fieldOfStudy        FieldOfStudy?       @relation("FieldCommunities", fields: [fieldOfStudyId], references: [id], onDelete: SetNull)
  fieldOfStudyId      String?
  
  level               Level?              @relation("LevelCommunities", fields: [levelId], references: [id], onDelete: SetNull)
  levelId             String?
  
  // Auto-assigned: true for field-only, level-only, or field+level communities
  isAutoAssigned      Boolean             @default(false)
  
  creator             User?               @relation("communityCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId           String?
  
  members             CommunityMember[]
  posts               CommunityPost[]
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([schoolId, fieldOfStudyId, levelId])
  @@index([schoolId])
  @@index([fieldOfStudyId])
  @@index([levelId])
  @@index([type])
}

enum CommunityType {
  FIELD_ONLY            // All students in field X
  LEVEL_ONLY            // All students in level Y
  FIELD_AND_LEVEL      // Students in field X and level Y
  STUDENT_CREATED      // User-created communities
}

model CommunityMember {
  id              String          @id @default(cuid())
  user            User            @relation("user", fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  community       Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId     String
  role            CommunityRole   @default(MEMBER)
  joinedAt        DateTime        @default(now())
  
  @@unique([userId, communityId])
  @@index([communityId])
  @@index([userId])
}

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
}

model CommunityPost {
  id              String          @id @default(cuid())
  content         String          @db.Text
  author          User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  community       Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId     String
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt])
}

// ============= Marketplace - Brands & Orders =============
model Brand {
  id              String              @id @default(cuid())
  name            String
  description     String?             @db.Text
  logo            String?
  seller          User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId        String
  
  listings        MarketplaceListing[]
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([sellerId])
}

model ShoppingCart {
  id              String              @id @default(cuid())
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String              @unique
  items           CartItem[]
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
}

model CartItem {
  id              String              @id @default(cuid())
  cart            ShoppingCart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId          String
  listing         MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId       String
  quantity        Int                 @default(1)
  
  @@unique([cartId, listingId])
  @@index([cartId])
  @@index([listingId])
}

model Order {
  id              String              @id @default(cuid())
  buyer           User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId         String
  items           OrderItem[]
  
  totalPrice      Float
  status          OrderStatus         @default(PENDING)
  paymentMethod   PaymentMethod       @default(MOBILE_MONEY)
  paymentStatus   PaymentStatus       @default(PENDING)
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id              String              @id @default(cuid())
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  listing         MarketplaceListing  @relation(fields: [listingId], references: [id])
  listingId       String
  quantity        Int
  pricePerUnit    Float
  
  @@index([orderId])
  @@index([listingId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  MOBILE_MONEY
  ORANGE_MONEY
}

// ============= Support System =============
model SupportTicket {
  id              String              @id @default(cuid())
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  
  title           String
  description     String              @db.Text
  category        TicketCategory
  priority        TicketPriority      @default(NORMAL)
  status          TicketStatus        @default(OPEN)
  
  messages        TicketMessage[]
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  resolvedAt      DateTime?

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id              String              @id @default(cuid())
  ticket          SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId        String

  sender          User?               @relation("TicketMessages", fields: [senderId], references: [id], onDelete: SetNull)
  senderId        String?
  isAdmin         Boolean             @default(false) // True if sent by admin/student-admin

  content         String              @db.Text
  attachments     String[]            @default([])

  createdAt       DateTime            @default(now())

  @@index([ticketId])
  @@index([senderId])
}

enum TicketCategory {
  TECHNICAL
  BEHAVIORAL
  INQUIRY
  BUG_REPORT
  FEATURE_REQUEST
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

// ============= Announcements =============
model Announcement {
  id              String              @id @default(cuid())
  title           String
  content         String              @db.Text
  
  status          AnnouncementStatus  @default(PENDING)
  priority        AnnouncementPriority @default(NORMAL)
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  publishedAt     DateTime?

  @@index([status])
  @@index([priority])
  @@index([publishedAt])
}

enum AnnouncementStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum AnnouncementPriority {
  NORMAL
  URGENT
  EMERGENCY
}

// ============= Admin Chat =============
model AdminChatGroup {
  id              String              @id @default(cuid())
  name            String              @default("Admin Channel")
  schoolId        String?
  messages        AdminChatMessage[]
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([schoolId])
}

model AdminChatMessage {
  id              String              @id @default(cuid())
  chatGroup       AdminChatGroup      @relation(fields: [chatGroupId], references: [id], onDelete: Cascade)
  chatGroupId     String
  
  sender          User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId        String
  
  content         String              @db.Text
  attachments     String[]            @default([])
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([chatGroupId])
  @@index([senderId])
}


model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id          String     @id @default(cuid())
  content     String     @db.Text
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  images      String[]   @default([]) // URLs
  video       String?    // Single video URL
  
  // Poll support
  isPoll      Boolean    @default(false)
  pollOptions PollOption[]
  
  // Audience
  audience    Audience   @default(EVERYONE)
  audienceGroup   Group? @relation("audienceGroup", fields: [audienceGroupId], references: [id])
  audienceGroupId String?
  
  // Group post
  groupPost   Group?     @relation("groupPosts", fields: [groupPostId], references: [id], onDelete: SetNull)
  groupPostId String?
  
  // Location
  location    String?
  
  // Engagement
  likes       Like[]
  comments    Comment[]
  shares      Int        @default(0)
  saves       String[]   @default([]) // User IDs who saved
  
  // Moderation
  isFlagged   Boolean    @default(false)
  flags       ModeratorFlag[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([audience])
  @@index([groupPostId])
  @@index([audienceGroupId])
}

enum Audience {
  EVERYONE
  DEPARTMENT
  FRIENDS_ONLY
  SPECIFIC_GROUP
}

model PollOption {
  id      String @id @default(cuid())
  text    String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String
  votes   String[] @default([]) // User IDs

  @@index([postId])
}

model Like {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  reaction  String   @default("👍") // 👍 ❤️ 😂 😮 😢
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  
  // Threaded comments
  parentComment   Comment?  @relation("replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  parentCommentId String?
  replies         Comment[] @relation("replies")
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([parentCommentId])
}

model Mention {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([postId])
  @@index([commentId])
}

// ============= Groups & Communities =============
model Group {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  photo       String?
  type        GroupType     @default(STUDENT_CREATED)
  
  // For auto-assigned groups
  department  String?
  year        String?
  courseCode  String?
  
  creator     User?         @relation("groupCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId   String?
  
  members     GroupMember[]
  posts       Post[]        @relation("groupPosts")
  audiencePosts Post[]      @relation("audienceGroup")
  events      Event[]
  
  isPublic    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type])
  @@index([department])
  @@index([year])
}

enum GroupType {
  AUTO_ASSIGNED_DEPARTMENT
  AUTO_ASSIGNED_YEAR
  OFFICIAL
  STUDENT_CREATED
  COURSE
}

model GroupMember {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
}

enum GroupRole {
  OWNER
  MODERATOR
  MEMBER
}

// ============= Messaging & Chat =============
model Message {
  id          String      @id @default(cuid())
  content     String      @db.Text
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String
  
  // For 1-on-1 chats
  recipient   User?       @relation("DirectMessages", fields: [recipientId], references: [id], onDelete: SetNull)
  recipientId String?
  
  // For group chats
  chatGroup   ChatGroup?  @relation(fields: [chatGroupId], references: [id], onDelete: Cascade)
  chatGroupId String?
  
  images      String[]    @default([])
  voiceUrl    String?     // 2 min max
  
  isRead      Boolean     @default(false)
  readAt      DateTime?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([senderId])
  @@index([recipientId])
  @@index([chatGroupId])
}

model ChatGroup {
  id        String    @id @default(cuid())
  name      String?
  photo     String?
  members   String[]  @default([]) // User IDs
  messages  Message[]
  createdAt DateTime  @default(now())

  @@index([members], type: Gin)
}

// ============= Events =============
model Event {
  id                  String          @id @default(cuid())
  title               String
  description         String?         @db.Text
  date                DateTime
  endDate             DateTime?
  location            String
  
  // Map coordinates
  latitude            Float?
  longitude           Float?
  
  capacity            Int?
  
  organizer           User            @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId         String
  
  group               Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId             String?
  
  attendees           EventAttendee[]
  
  isRecurring         Boolean         @default(false)
  recurrencePattern   String?         // e.g., "WEEKLY"
  
  isFree              Boolean         @default(true)
  ticketPrice         Float?
  
  qrCheckIn           String?
  bannerImage         String?
  category            String?
  
  // Approval workflow
  approvalStatus      EventApprovalStatus @default(PENDING)
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([organizerId])
  @@index([date])
  @@index([approvalStatus])
}

enum EventApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventAttendee {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  status    RSVPStatus @default(INTERESTED)
  checkedIn Boolean  @default(false)
  joinedAt  DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

enum RSVPStatus {
  INTERESTED
  GOING
  MAYBE
  NOT_GOING
}

// ============= Marketplace =============
model MarketplaceListing {
  id              String      @id @default(cuid())
  title           String
  description     String      @db.Text
  seller          User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId        String
  
  brand           Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId         String?
  
  category        MarketplaceCategory
  condition       Condition
  
  price           Float?
  isFree          Boolean     @default(false)
  isTradeOnly     Boolean     @default(false)
  
  images          String[]    @default([])
  
  preferredContact String? // "chat", "phone", "email"
  
  status          ListingStatus @default(ACTIVE)
  expiresAt       DateTime?
  
  isFlagged       Boolean     @default(false)
  flags           ModeratorFlag[]
  
  reviews         Review[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([sellerId])
  @@index([brandId])
  @@index([category])
  @@index([status])
}

enum MarketplaceCategory {
  TEXTBOOKS
  ELECTRONICS
  FURNITURE
  HOUSING
  SERVICES
  TICKETS
  OTHER
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  REMOVED
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?  @db.Text
  
  reviewer  User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String
  
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  
  createdAt DateTime @default(now())

  @@index([reviewerId])
  @@index([listingId])
}

// ============= Moderation =============
model ModeratorFlag {
  id              String   @id @default(cuid())
  reason          String
  status          FlagStatus @default(PENDING)
  contentSnapshot String?  @db.Text // Snapshot of content at time of report
  schoolId        String?  // School scope for isolation

  reporter        User?    @relation("ReportedFlags", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId      String?

  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?

  listing   MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String?

  resolvedBy      String?  // userId who resolved/removed
  resolvedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([listingId])
  @@index([status])
  @@index([reporterId])
  @@index([schoolId])
}

enum FlagStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  APPROVED
  DISMISSED
}

// ============= Stories =============
model Story {
  id        String   @id @default(cuid())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  mediaUrl  String?
  caption   String?  @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([authorId])
  @@index([expiresAt])
}

// ============= Lost & Found =============
model LostFoundItem {
  id          String         @id @default(cuid())
  type        LostFoundType  @default(LOST)
  title       String
  description String?        @db.Text
  location    String?
  category    String         @default("Other")
  photoUrl    String?
  resolved    Boolean        @default(false)
  poster      User           @relation(fields: [posterId], references: [id], onDelete: Cascade)
  posterId    String
  schoolId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([posterId])
  @@index([schoolId])
  @@index([resolved])
  @@index([createdAt])
}

enum LostFoundType {
  LOST
  FOUND
}

// ============= Notifications =============
model Notification {
  id        String   @id @default(cuid())
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  message   String   @db.Text
  actionUrl String?
  
  isRead    Boolean  @default(false)
  readAt    DateTime?
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead, createdAt])
  @@index([createdAt])
}

enum NotificationType {
  FRIEND_REQUEST
  COMMENT
  LIKE
  MENTION
  EVENT_REMINDER
  MESSAGE
  MARKETPLACE_ALERT
  SYSTEM_ALERT
  GROUP_JOIN_REQUEST
  GROUP_JOIN_APPROVED
  GROUP_JOIN_REJECTED
  EVENT_APPROVED
  EVENT_REJECTED
  SUPPORT_REPLY
  MODERATION_ACTION
}

// ============= Library Resources =============
model LibraryResource {
  id          String   @id @default(cuid())
  title       String
  type        String   // PDF, VIDEO, LINK, IMAGE, TEXT, COURSE
  description String?  @db.Text
  url         String?  // For PDF, VIDEO, LINK, IMAGE
  content     String?  @db.Text // For TEXT type
  schoolId    String
  uploadedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id])
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])

  @@index([schoolId])
  @@index([type])
  @@index([createdAt])
  @@index([uploadedById])
}

// ============= Analytics & Logging =============
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  resource  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
